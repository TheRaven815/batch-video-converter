# Video Converter — Coolify deployment environment
# Adjust paths below to match your Raspberry Pi / server host paths.
# Media paths must match the volume mounts in docker-compose.coolify.yml.

VIDEO_CONVERTER_STORAGE=redis
REDIS_URL=redis://redis:6379/0
DATA_ROOT=/data
MEDIA_MOUNTS=Movies=/media/movies;TV Series=/media/tv-series;Downloads=/media/downloads

# Keep per-process FFmpeg CPU use bounded; increase only after measuring the host.
# WORKER_CONCURRENCY=1
# FFMPEG_THREADS=1

# --- Authentication (optional) ---
# There are no default credentials. If APP_PASSWORD is left unset, the UI
# shows a one-time setup screen on first run to create the admin account.
# Set APP_USERNAME/APP_PASSWORD only to pre-provision credentials instead.
# APP_USERNAME=admin
# APP_PASSWORD=

# JWT signing secret. If unset, a secret is generated once and persisted under
# DATA_ROOT/data/jwt_secret. Set it explicitly for multi-instance deployments.
# JWT_SECRET=
