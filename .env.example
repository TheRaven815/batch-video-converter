# Video Converter — Environment Configuration
# Copy this file to .env and adjust values for your deployment.

# Storage backend: "redis" for Docker/production, "local" for local SQLite development
VIDEO_CONVERTER_STORAGE=redis

# Redis connection URL (only used when VIDEO_CONVERTER_STORAGE=redis)
REDIS_URL=redis://redis:6379/0

# Root directory for runtime data (inputs, outputs, temp, logs, SQLite data)
DATA_ROOT=/data

# Media roots available for browsing in the UI
# Format: Label=/container/path;Label2=/container/path2
# If empty, defaults to DATA_ROOT/input
MEDIA_MOUNTS=Movies=/media/movies;Series=/media/series

# Number of concurrent job processing threads in the worker (default: 1)
# Increase for parallel FFmpeg jobs; requires proportional CPU/RAM resources.
# On Raspberry Pi or constrained environments, keep at 1.
# WORKER_CONCURRENCY=1

# Maximum encoder threads used by each FFmpeg process (1-32, default: 1).
# Total conversion CPU pressure is roughly WORKER_CONCURRENCY * FFMPEG_THREADS.
# FFMPEG_THREADS=1

# --- Authentication (optional) ---
# There are no default credentials. If APP_PASSWORD is left unset, the UI
# shows a one-time setup screen on first run to create the admin account.
# Set APP_USERNAME/APP_PASSWORD only to pre-provision credentials instead.
# APP_USERNAME=admin
# APP_PASSWORD=

# JWT signing secret. If unset, a secret is generated once and persisted under
# DATA_ROOT/data/jwt_secret. Set it explicitly for multi-instance deployments.
# JWT_SECRET=
