# Minimal required env — Docker Compose (Coolify / local) will run with just these.
# Copy to .env:  cp .env.example .env  (Linux)  or  copy .env.example .env  (Windows)
# All other settings have safe defaults in docker-compose.yml / src/video_converter/core/config.py:32.

# --- REQUIRED: host paths -> container read-only mounts (must match MEDIA_MOUNTS) ---
# Use absolute host paths on the Docker host (the server / NAS), not your laptop.
# Avoid spaces in host folder names — if you must, keep the quotes: "/srv/media/TV Series"
MEDIA_MOUNTS=Movies=/media/movies;Series=/media/series;Downloads=/media/downloads
MEDIA_MOVIES_SOURCE=/srv/media/movies
MEDIA_SERIES_SOURCE=/srv/media/series
MEDIA_DOWNLOADS_SOURCE=/srv/media/downloads

# Writable app data — named volume (Coolify) or bind path (local dev).
# Coolify: keep as "app-data"  ·  Local dev: "./data"
APP_DATA_SOURCE=app-data

# --- OPTIONAL: uncomment only if you need to override defaults ---
# VIDEO_CONVERTER_STORAGE=redis
# REDIS_URL=redis://redis:6379/0
# DATA_ROOT=/app-data
# Docker-only resource limits (Compose defaults; CPU units = logical cores).
# App quota shared by API, worker and FFmpeg/ffprobe; Redis has separate quota.
# Host/Coolify/other containers are not capped. Ignored outside Docker.
# APP_CPU_LIMIT=2.0
# REDIS_CPU_LIMIT=0.5
# APP_MEMORY_LIMIT=2g
# REDIS_MEMORY_LIMIT=256m
# Recommended Pi 5 overrides: APP_CPU_LIMIT=1.5, REDIS_CPU_LIMIT=0.25,
# WORKER_CONCURRENCY=1, FFMPEG_THREADS=1; keep memory defaults initially.
# WORKER_CONCURRENCY (1..8) is hard ceiling; UI may only reduce active jobs.
# FFMPEG_THREADS (1..32) bounds FFmpeg thread pools, not CPU time.
# WORKER_CONCURRENCY=1
# FFMPEG_THREADS=1
# FFMPEG_STALL_TIMEOUT_SECONDS=300
# MIN_FREE_DISK_BYTES=536870912
# MAX_UPLOAD_BYTES=10737418240

# Auth — optional, forwarded to the app container by Docker Compose.
# If APP_PASSWORD is empty, complete first-run setup on a private network before
# exposing the service publicly. Empty JWT_SECRET is auto-generated and persisted
# at DATA_ROOT/data/jwt_secret; keep the app data volume across restarts.
# APP_USERNAME=admin
# APP_PASSWORD=
# JWT_SECRET=
